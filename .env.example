# --- Required for money-making ---
AMAZON_ASSOCIATE_TAG=yourtag-20        # your Amazon Associates store ID
SITE_NAME=WirelessChoice
SITE_URL=http://localhost:8000
ADMIN_PASSWORD=change-me               # protects /admin (disabled if empty)

# --- AI (optional; templates are used if missing) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
VOYAGE_API_KEY=                        # optional better embeddings; local hashing embedder otherwise

# --- Data sources (optional; demo data is used if missing) ---
YOUTUBE_API_KEY=                       # YouTube Data API v3 (official, ToS-compliant)
ENABLE_TRENDS=1                        # Google Trends via pytrends

# --- Social (optional) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
AUTO_PUBLISH_APPROVED=0                # 1 = scheduler posts items YOU approved

# --- Automation ---
PIPELINE_INTERVAL_HOURS=24             # 0 disables the background scheduler
MONTHLY_AD_BUDGET_USD=0                # planning cap only; the app never spends money
DB_PATH=wirelesschoice.db
